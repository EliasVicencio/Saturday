# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env real a GitHub

# URL del backend
VITE_API_URL=http://localhost:5000/api

# Debe ser EXACTAMENTE el mismo valor que SATURDAY_API_KEY en backend/.env
# Genera uno fuerte con: python -c "import secrets; print(secrets.token_hex(32))"
VITE_SATURDAY_API_KEY=
