# ============================================
# SATURDAY - Variables de entorno
# Copia este archivo como .env y completa tus credenciales
# NUNCA subas este archivo a GitHub
# ============================================

# ============================================
# NOTION
# ============================================
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# GOOGLE CLOUD (TTS + STT + Calendar + Email)
# ============================================
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Voz de Saturday (Google Cloud TTS)
# Opciones en español:
#   es-US-Neural2-A (femenino, latino)
#   es-US-Neural2-C (masculino, latino) 
#   es-ES-Neural2-B (femenino, España)
#   es-ES-Neural2-C (masculino, España)
#   es-ES-Chirp3-HD-Charon (masculino, HD, España)
#   es-US-Chirp3-HD-Leda (femenino, HD, latino)
#   es-US-Chirp3-HD-Puck (masculino, HD, latino)
SATURDAY_VOICE=es-ES-Chirp3-HD-Charon
SATURDAY_LANGUAGE=es-ES

# ============================================
# OPENWEATHER (Clima)
# ============================================
WEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SATURDAY_CITY=Santiago,CL

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=xxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# BACKEND API
# ============================================
VITE_API_URL=http://localhost:5000/api

# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
SATURDAY_TIMEZONE=America/Santiago