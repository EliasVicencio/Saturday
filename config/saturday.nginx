server {
    listen 80;
    server_name saturday.viewdns.net;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name saturday.viewdns.net;

    ssl_certificate /etc/letsencrypt/live/saturday.viewdns.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/saturday.viewdns.net/privkey.pem;

    root /home/ubuntu/Saturday/frontend/dist;

    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Service-Worker-Allowed "/";
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /webhook {
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
